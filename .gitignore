```gitignore
# ==============================
# MARIS — Secrets and environment
# ==============================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# ==============================
# Python / FastAPI
# ==============================
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==============================
# Node.js / Next.js
# ==============================
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Logs and local databases
# ==============================
*.log
*.sqlite
*.sqlite3
*.db

# ==============================
# Generated course data
# ==============================
data/raw/
data/uploads/
data/processed/
data/indexes/
data/embeddings/

# ==============================
# Editors and operating system
# ==============================
.DS_Store
Thumbs.db
.idea/

# VS Code: keep shared project settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
```